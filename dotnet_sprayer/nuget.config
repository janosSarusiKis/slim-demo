<?xml version="1.0" encoding="utf-8"?>
<!-- Restore only from nuget.org into a folder of our own, so packages a local
     feed put into the shared ~/.nuget cache under the same version can't leak in. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
